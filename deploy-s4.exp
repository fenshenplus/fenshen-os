#!/usr/bin/expect -f
# 分身官网推送脚本（S4 服务器：39.105.6.135）
# 用法： expect deploy-s4.exp
# 前置：S4 网络可达（当前 22 端口不可达，待恢复后执行）
# 动作：备份旧 index.html → 上传 v6.1 dmg（英文名传输后重命名为中文名，规避编码问题）→ 覆盖 index.html → 删除旧 v6.0 dmg

set timeout 240
set host "39.105.6.135"
set user "root"
set pass "REDACTED_ECS_PASSWORD"
set remote_dir "/var/www/fenshen"

# 本地临时英文名，规避 scp 传输阶段中文编码风险
set tmp_dmg "/tmp/fenshen-v6.1-macOS.dmg"
exec cp "site/分身-v6.1-macOS.dmg" $tmp_dmg

proc push {host user pass remote_dir tmp_dmg} {
    # 1) 上传 dmg（英文临时名）
    spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $tmp_dmg $user@$host:$remote_dir/fenshen-v6.1-macOS.dmg
    expect {
        -re "(?i)password:" { send "$pass\r"; exp_continue }
        eof
    }
    # 2) 上传 index.html
    spawn scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "site/index.html" $user@$host:$remote_dir/index.html
    expect {
        -re "(?i)password:" { send "$pass\r"; exp_continue }
        eof
    }
    # 3) 备份旧 index + 重命名 dmg 为中文名 + 删除旧版 dmg
    spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $user@$host "cd $remote_dir && cp -f index.html index.html.bak.\$(date +%Y%m%d%H%M) && mv -f fenshen-v6.1-macOS.dmg 分身-v6.1-macOS.dmg && rm -f 分身-v6.0-macOS.dmg && echo DEPLOY_OK && ls -la 分身-v6.1-macOS.dmg index.html"
    expect {
        -re "(?i)password:" { send "$pass\r"; exp_continue }
        eof
    }
}

push $host $user $pass $remote_dir $tmp_dmg
exec rm -f $tmp_dmg
puts "\n[完成] 推送脚本执行完毕（若上方无 DEPLOY_OK 且 S4 不可达，请待网络恢复后重跑 expect deploy-s4.exp）"
